{
  "name": "robot-preview-urdf-mjcf",
  "displayName": "Robot Preview: URDF, Xacro & MJCF",
  "description": "Live 3D viewer for URDF, Xacro and MJCF robot models (ROS, ROS 2, MuJoCo) inside VS Code",
  "version": "0.4.1",
  "publisher": "chenyuting3077",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenyuting3077/robot-preview"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:robotPreviewUrdf.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "robotPreviewUrdf.open",
        "title": "Open Preview to the Side",
        "category": "Robot Preview",
        "icon": "$(preview)"
      },
      {
        "command": "robotPreviewUrdf.setXacroArgs",
        "title": "Set Xacro Arguments",
        "category": "Robot Preview"
      },
      {
        "command": "robotPreviewUrdf.exportUrdf",
        "title": "Export Expanded URDF",
        "category": "Robot Preview"
      },
      {
        "command": "robotPreviewUrdf.saveScreenshot",
        "title": "Save Screenshot",
        "category": "Robot Preview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "robotPreviewUrdf.open",
          "when": "resourceExtname =~ /^\\.(urdf|xacro|xml)$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "robotPreviewUrdf.open",
          "when": "resourceExtname =~ /^\\.(urdf|xacro|xml)$/"
        },
        {
          "command": "robotPreviewUrdf.setXacroArgs",
          "when": "resourceExtname == .xacro"
        }
      ],
      "commandPalette": [
        {
          "command": "robotPreviewUrdf.open",
          "when": "resourceExtname =~ /^\\.(urdf|xacro|xml)$/"
        },
        {
          "command": "robotPreviewUrdf.setXacroArgs",
          "when": "resourceExtname == .xacro"
        },
        {
          "command": "robotPreviewUrdf.exportUrdf",
          "when": "resourceExtname == .xacro"
        }
      ]
    },
    "languages": [
      {
        "id": "xml",
        "extensions": [
          ".urdf",
          ".xacro"
        ]
      }
    ],
    "configuration": {
      "title": "Robot Preview: URDF, Xacro & MJCF",
      "properties": {
        "robotPreviewUrdf.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open the preview beside the editor when a URDF, Xacro or MJCF file becomes active."
        },
        "robotPreviewUrdf.updateOn": {
          "type": "string",
          "enum": [
            "type",
            "save"
          ],
          "default": "type",
          "enumDescriptions": [
            "Rebuild the preview 300 ms after typing stops, including unsaved edits, like the Markdown preview.",
            "Rebuild the preview only when a file is saved."
          ],
          "description": "When the preview picks up edits made in VS Code. Changes made outside VS Code always update immediately."
        },
        "robotPreviewUrdf.packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Package name to folder, for `package://` and `$(find)` packages without a `package.xml` in the workspace or a sourced ROS environment. Takes priority over automatic discovery. Supports `${workspaceFolder}`, `${workspaceFolder:name}`, `${env:VAR}` and `~`; relative paths start at the first workspace folder."
        },
        "robotPreviewUrdf.checks.disabled": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "string",
            "enum": [
              "unknown-link",
              "multiple-parents",
              "kinematic-loop",
              "duplicate-name",
              "multiple-roots",
              "missing-limit",
              "missing-mass",
              "missing-inertial",
              "nonpositive-mass",
              "invalid-inertia",
              "zero-axis",
              "inverted-limit",
              "zero-effort-velocity",
              "continuous-with-limits",
              "collision-scale-mismatch"
            ],
            "enumDescriptions": [
              "A joint names a link that does not exist (error).",
              "A link is the child of more than one joint (error).",
              "Joints form a loop instead of a tree (error).",
              "Two links or two joints share a name (error).",
              "More than one link has no parent (error).",
              "A revolute or prismatic joint has no <limit>, or a <limit> lacks effort or velocity (error).",
              "An <inertial> has no <mass> (error).",
              "A non-root link with geometry has no <inertial>.",
              "A link has a mass of zero or less.",
              "An inertia is not positive definite or breaks the triangle inequality.",
              "A moving joint has a zero axis.",
              "A joint limit has lower > upper.",
              "A joint limit has zero effort or velocity.",
              "A continuous joint sets lower/upper, which are ignored.",
              "Visual and collision sizes differ 100x or more (likely mm vs m)."
            ]
          },
          "markdownDescription": "Model checks to skip. Each Problems entry shows its rule id as the code."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "robotPreviewUrdf.mesh",
        "displayName": "Robot Preview: Mesh",
        "selector": [
          {
            "filenamePattern": "*.stl"
          },
          {
            "filenamePattern": "*.STL"
          },
          {
            "filenamePattern": "*.dae"
          },
          {
            "filenamePattern": "*.DAE"
          },
          {
            "filenamePattern": "*.obj"
          },
          {
            "filenamePattern": "*.OBJ"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "package": "npx --yes -p node@20 -p @vscode/vsce@3 vsce package --no-dependencies --baseImagesUrl https://github.com/chenyuting3077/robot-preview/raw/HEAD/packages/urdf-mjcf"
  },
  "bugs": {
    "url": "https://github.com/chenyuting3077/robot-preview/issues"
  },
  "keywords": [
    "urdf",
    "xacro",
    "mjcf",
    "mujoco",
    "ros",
    "robot",
    "3d",
    "preview",
    "ros2",
    "robotics",
    "urdf viewer",
    "kinematics",
    "rviz",
    "viewer",
    "urdf visualizer",
    "urdf preview",
    "xacro viewer",
    "mjcf viewer",
    "mujoco viewer",
    "ros 2",
    "gazebo"
  ]
}
