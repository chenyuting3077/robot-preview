{
  "name": "robot-preview-mesh-splat",
  "displayName": "Robot Preview: Gaussian Splat, Point Cloud, STEP & STL Viewer",
  "description": "Fast 3D viewer for Gaussian splats (3DGS, 2DGS), large point clouds (PCD, PLY, XYZ), STEP and IGES CAD models and meshes (STL, OBJ, glTF) inside VS Code",
  "version": "0.4.0",
  "publisher": "chenyuting3077",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenyuting3077/robot-preview"
  },
  "bugs": {
    "url": "https://github.com/chenyuting3077/robot-preview/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "robotPreviewMeshSplat.viewer",
        "displayName": "Robot Preview: Mesh & Splat",
        "selector": [
          {
            "filenamePattern": "*.stl"
          },
          {
            "filenamePattern": "*.ply"
          },
          {
            "filenamePattern": "*.obj"
          },
          {
            "filenamePattern": "*.off"
          },
          {
            "filenamePattern": "*.dae"
          },
          {
            "filenamePattern": "*.gltf"
          },
          {
            "filenamePattern": "*.glb"
          },
          {
            "filenamePattern": "*.3mf"
          },
          {
            "filenamePattern": "*.wrl"
          },
          {
            "filenamePattern": "*.3ds"
          },
          {
            "filenamePattern": "*.pcd"
          },
          {
            "filenamePattern": "*.xyz"
          },
          {
            "filenamePattern": "*.pts"
          },
          {
            "filenamePattern": "*.splat"
          },
          {
            "filenamePattern": "*.ksplat"
          },
          {
            "filenamePattern": "*.spz"
          },
          {
            "filenamePattern": "*.sog"
          },
          {
            "filenamePattern": "*.stp"
          },
          {
            "filenamePattern": "*.step"
          },
          {
            "filenamePattern": "*.igs"
          },
          {
            "filenamePattern": "*.iges"
          },
          {
            "filenamePattern": "*.pgm"
          },
          {
            "filenamePattern": "*.pcd.bin"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "robotPreviewMeshSplat.textPoints",
        "displayName": "Robot Preview: Mesh & Splat",
        "selector": [
          {
            "filenamePattern": "*.asc"
          },
          {
            "filenamePattern": "*.bin"
          },
          {
            "filenamePattern": "*.yaml"
          },
          {
            "filenamePattern": "*.yml"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "robotPreviewMeshSplat.openAsPoints",
        "title": "Open as Point Cloud",
        "category": "Robot Preview",
        "icon": {
          "light": "images/preview-light.svg",
          "dark": "images/preview-dark.svg"
        }
      },
      {
        "command": "robotPreviewMeshSplat.addToView",
        "title": "Add to Point Cloud View",
        "category": "Robot Preview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "robotPreviewMeshSplat.openAsPoints",
          "when": "resourceExtname =~ /^\\.(bin|asc)$/i && activeCustomEditorId != robotPreviewMeshSplat.textPoints && activeCustomEditorId != robotPreviewMeshSplat.viewer",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "robotPreviewMeshSplat.openAsPoints",
          "when": "resourceExtname =~ /^\\.(bin|asc)$/i"
        },
        {
          "command": "robotPreviewMeshSplat.addToView",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^\\.(stl|ply|obj|off|dae|gltf|glb|3mf|wrl|3ds|pcd|xyz|pts|splat|ksplat|spz|sog|pgm|asc|bin)$/i",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "robotPreviewMeshSplat.openAsPoints",
          "when": "resourceExtname =~ /^\\.(bin|asc)$/i"
        },
        {
          "command": "robotPreviewMeshSplat.addToView",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "vite build",
    "package": "vite build && npx --yes -p node@20 -p @vscode/vsce@3 vsce package --no-dependencies --baseImagesUrl https://github.com/chenyuting3077/robot-preview/raw/HEAD/packages/mesh-splat",
    "publish:ovsx": "npm run build && npx --yes -p node@20 -p ovsx@0.10.6 ovsx publish --no-dependencies --skip-duplicate --baseImagesUrl https://github.com/chenyuting3077/robot-preview/raw/HEAD/packages/mesh-splat"
  },
  "keywords": [
    "mesh",
    "point cloud",
    "gaussian splatting",
    "3dgs",
    "2dgs",
    "ply",
    "stl",
    "obj",
    "gltf",
    "meshlab",
    "preview",
    "viewer",
    "3d viewer",
    "stl viewer",
    "ply viewer",
    "point cloud viewer",
    "pcd",
    "glb",
    "splat",
    "3d gaussian splatting",
    "step",
    "stp",
    "cad",
    "step viewer",
    "cad viewer",
    "2d gaussian splatting",
    "lidar",
    "large point cloud",
    "3d model viewer",
    "step file"
  ],
  "dependencies": {
    "@sparkjsdev/spark": "2.4.0",
    "js-yaml": "4.3.2",
    "meshoptimizer": "1.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "vite": "5.4.21"
  }
}
