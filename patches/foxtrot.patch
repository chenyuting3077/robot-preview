+/// The curve a swept surface is built from, as homogeneous control points
+/// (weight 1 for a non-rational B-spline).
+fn swept_curve(s: &StepFile, c: ap214::Curve) -> Result<(bool, KnotVector, Vec<DVec4>), Error> {
+    let (bspline, weights) = match &s[c] {
+        Entity::BSplineCurveWithKnots(b) => (b, None),
+        Entity::ComplexEntity(v) => {
+            let bspline = v.iter().find_map(|e| match e {
+                Entity::BSplineCurveWithKnots(b) => Some(b),
+                _ => None,
+            });
+            let rational = v.iter().find_map(|e| match e {
+                Entity::RationalBSplineCurve(r) => Some(r),
+                _ => None,
+            });
+            match (bspline, rational) {
+                (Some(b), Some(r)) => (b, Some(&r.weights_data)),
+                _ => return Err(Error::UnknownCurveType),
+            }
+        },
+        e => {
+            warn!("Could not get swept curve from {:?}", e);
+            return Err(Error::UnknownCurveType);
+        },
+    };
+    let knots: Vec<f64> = bspline.knots.iter().map(|k| k.0).collect();
+    let multiplicities: Vec<usize> = bspline.knot_multiplicities.iter()
+        .map(|&k| k.try_into().expect("Got negative multiplicity"))
+        .collect();
+    let knot_vec = KnotVector::from_multiplicities(
+        bspline.degree.try_into().expect("Got negative degree"),
+        &knots, &multiplicities);
+    let points = control_points_1d(s, &bspline.control_points_list);
+    let points = match weights {
+        Some(w) => points.iter().zip(w.iter())
+            .map(|(p, w)| DVec4::new(p.x * w, p.y * w, p.z * w, *w))
+            .collect(),
+        None => points.iter().map(|p| DVec4::new(p.x, p.y, p.z, 1.0)).collect(),
+    };
+    Ok((bspline.closed_curve.0 != Some(true), knot_vec, points))
+}
+
 fn control_points_1d(s: &StepFile, row: &Vec<CartesianPoint>) -> Vec<DVec3> {
     row.iter().map(|p| cartesian_point(s, *p)).collect()
 }
