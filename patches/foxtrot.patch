+
+/// A triangle mesh in the file's own units, with per-vertex normals and
+/// colors (0-1 RGB), plus how many faces could not be triangulated.
+#[wasm_bindgen]
+pub struct StepMesh {
+    positions: Vec<f32>,
+    normals: Vec<f32>,
+    colors: Vec<f32>,
+    indices: Vec<u32>,
+    faces: usize,
+    failed: usize,
+}
+
+#[wasm_bindgen]
+impl StepMesh {
+    pub fn take_positions(&mut self) -> Vec<f32> { std::mem::take(&mut self.positions) }
+    pub fn take_normals(&mut self) -> Vec<f32> { std::mem::take(&mut self.normals) }
+    pub fn take_colors(&mut self) -> Vec<f32> { std::mem::take(&mut self.colors) }
+    pub fn take_indices(&mut self) -> Vec<u32> { std::mem::take(&mut self.indices) }
+    #[wasm_bindgen(getter)]
+    pub fn faces(&self) -> usize { self.faces }
+    #[wasm_bindgen(getter)]
+    pub fn failed(&self) -> usize { self.failed }
+}
+
+#[wasm_bindgen]
+pub fn step_to_mesh(data: Vec<u8>, part: usize, parts: usize) -> StepMesh {
+    use step::step_file::StepFile;
+    use triangulate::triangulate::triangulate_part;
+
+    // Owned and freed as soon as possible: WASM memory never shrinks, so every copy alive at
+    // the same time raises the worker's memory for good.
+    let flat = StepFile::strip_flatten(&data);
+    drop(data);
+    let step = StepFile::parse(&flat);
+    let (mesh, stats) = triangulate_part(&step, part, parts.max(1));
+    drop(step);
+    drop(flat);
+    let pack = |f: &dyn Fn(&triangulate::mesh::Vertex) -> [f64; 3]| -> Vec<f32> {
+        mesh.verts.iter().flat_map(|v| f(v)).map(|x| x as f32).collect()
+    };
+    StepMesh {
+        positions: pack(&|v| [v.pos.x, v.pos.y, v.pos.z]),
+        normals: pack(&|v| [v.norm.x, v.norm.y, v.norm.z]),
+        colors: pack(&|v| [v.color.x, v.color.y, v.color.z]),
+        indices: mesh.triangles.iter().flat_map(|t| t.verts.iter().copied()).collect(),
+        faces: stats.num_faces,
+        failed: stats.num_errors + stats.num_panics,
+    }
+}
