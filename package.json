{
  "name": "robot-preview-urdf-mjcf",
  "version": "0.1.0",
  "description": "VS Code extension for previewing URDF, Xacro and MJCF robot models",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "vite build",
    "package": "vite build && cd vscode-extension && npm run package",
    "test": "node --import ./tests/setup.mjs --test tests/animation/*.test.js tests/mjcf/*.test.js tests/viewer/*.test.mjs tests/extension/*.test.mjs",
    "test:e2e": "vite build && npx -y -p node@22 node tests/e2e/webview.mjs"
  },
  "keywords": [
    "robot",
    "urdf",
    "xacro",
    "mjcf",
    "three.js",
    "viewer",
    "vscode"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@babel/runtime": "^7.23.0",
    "d3": "^7.9.0",
    "mujoco-js": "^0.0.7",
    "three": "^0.163.0",
    "urdf-loader": "^0.12.5",
    "xacro-parser": "^0.3.11"
  },
  "devDependencies": {
    "linkedom": "0.18.12",
    "terser": "^5.26.0",
    "vite": "^4.5.0"
  }
}
